    <link name="depth_camera_link">
      <pose>0.1 0 0.05 0 -0.2618 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
