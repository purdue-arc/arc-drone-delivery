<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="apriltag_world">

    <!-- Ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
	<uri>model://sun</uri>
    <!-- Physics: PX4's stock SITL values (see empty.world).
         The previous block used max_step_size 0.01 at 100 Hz with no ODE
         solver tuning. With that coarse a step the contact solver
         under-resolves the airframe resting on its legs, and the simulated
         accelerometer reads about -8.3 m/s^2 instead of -9.81 while the
         vehicle is stationary. EKF2 reads that 1.5 m/s^2 shortfall as a real
         downward acceleration, diverges, and the vehicle never passes
         preflight: "Preflight Fail: High Accelerometer Bias". -->
    <physics name='default_physics' default='0' type='ode'>
      <gravity>0 0 -9.8066</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>10</iters>
          <sor>1.3</sor>
          <use_dynamic_moi_rescaling>0</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <magnetic_field>6.0e-6 2.3e-5 -4.2e-5</magnetic_field>
    </physics>
    </include>

    <!-- AprilTag as a flat box with texture -->
    <model name="Apriltag_36_11_00000">
      <static>true</static>
      <pose>0 0 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
            <geometry>
            <box><size>0.5 0.5 0.001</size></box>
          </geometry>
          <material>
    <script>
      <uri>model://Apriltag36_11_00000/materials/scripts</uri>
      <uri>model://Apriltag36_11_00000/materials/textures</uri>
      <name>Apriltag36_11_00000</name>
    </script>
    </material>
          </visual>
      </link>
    </model>
	
    <scene>
    <shadows>false</shadows>
    <grid>true</grid>
    <origin_visual>true</origin_visual>
    <ambient>0.4 0.4 0.4 1</ambient>
    <background>0.7 0.7 0.7 1</background>
  </scene>
  </world>
</sdf>
