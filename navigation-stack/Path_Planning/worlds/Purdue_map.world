<?xml version="1.0"?>
<sdf version="1.4">
  <world name="default">
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>
    <model name="my_mesh">
      <pose>0 0 0  0 0 0</pose>
      <static>true</static>
      <link name="body">
        <!-- Visual mesh so you can see the campus -->
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>file:///home/raghav/Documents/arc-drone-delivery/navigation-stack/Path_Planning/worlds/Purdue_map.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <!-- Collision mesh so sensors and the drone can physically detect buildings -->
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>file:///home/raghav/Documents/arc-drone-delivery/navigation-stack/Path_Planning/worlds/Purdue_map.dae</uri>
            </mesh>
          </geometry>
        </collision>
      </link>
    </model>
  </world>
</sdf>