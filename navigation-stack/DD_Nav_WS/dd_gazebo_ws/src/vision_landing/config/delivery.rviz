Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
    Tree Height: 700
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 40; 42; 48
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 5
      Plane Cell Count: 40
      Color: 90; 90; 100
      Alpha: 0.35

    - Class: rviz_default_plugins/TF
      Name: TF (map/odom/base_link)
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 3

    # Livox Mid-360 stand-in. Coloured by height so the building stands out
    # from the ground return.
    - Class: rviz_default_plugins/PointCloud2
      Name: Livox Mid-360 (/livox/points)
      Enabled: true
      Topic:
        Value: /livox/points
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 3
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Intensity Bounds: true
      Decay Time: 0

    # What Nav2 actually plans against.
    - Class: rviz_default_plugins/Map
      Name: Global costmap
      Enabled: true
      Topic:
        Value: /global_costmap/costmap
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: costmap
      Alpha: 0.55

    # The route the mission is flying — this is the obstacle avoidance.
    - Class: rviz_default_plugins/Path
      Name: Nav2 transit path
      Enabled: true
      Topic:
        Value: /arc/transit/path
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 25; 255; 120
      Line Style: Billboards
      Line Width: 0.25

    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic:
        Value: /odometry/filtered
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Keep: 300
      Shape:
        Value: Arrow
        Color: 255; 200; 40
        Alpha: 0.7
        Shaft Length: 0.6
        Shaft Radius: 0.08
        Head Length: 0.25
        Head Radius: 0.18
      Covariance:
        Value: false

    # Where the mission thinks the landing pad is.
    - Class: rviz_default_plugins/Pose
      Name: Landing target
      Enabled: true
      Topic:
        Value: /landing_target_pose
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Shape: Axes
      Axes Length: 1.0
      Axes Radius: 0.12

    - Class: rviz_default_plugins/Pose
      Name: Transit goal
      Enabled: true
      Topic:
        Value: /arc/transit/goal
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Shape: Arrow
      Color: 255; 60; 60
      Alpha: 1
      Shaft Length: 1.5
      Shaft Radius: 0.2
      Head Length: 0.6
      Head Radius: 0.4

    # AprilTag detector view. Off by default — enable it to watch the pad
    # come into frame during the landing.
    - Class: rviz_default_plugins/Image
      Name: Camera (debug)
      Enabled: false
      Topic:
        Value: /image_debug
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort

  Global Options:
    Fixed Frame: map
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Orbit
      Distance: 70
      Pitch: 0.62
      Yaw: 2.35
      Focal Point:
        X: 20
        Y: 0
        Z: 5
      Target Frame: map
Window Geometry:
  Height: 1000
  Width: 1600
  Displays:
    collapsed: false
