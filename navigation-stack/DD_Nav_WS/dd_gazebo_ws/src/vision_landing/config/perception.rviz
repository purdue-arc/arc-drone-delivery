# Perception view: the Livox Mid-360 point cloud in 3D, the TF tree, and the
# AprilTag landing-target pose. This is the "what does the aircraft see"
# window — the building shows up as a wall of returns during transit.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
    Tree Height: 560
  - Class: rviz_common/Selection
    Name: Selection
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 22; 24; 30
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 5
      Plane Cell Count: 30
      Color: 70; 72; 84
      Alpha: 0.3

    - Class: rviz_default_plugins/PointCloud2
      Name: Livox Mid-360
      Enabled: true
      Topic:
        Value: /livox/points
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 3
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: true
      Autocompute Intensity Bounds: true
      Decay Time: 0.3

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 3

    - Class: rviz_default_plugins/Pose
      Name: Landing target (AprilTag)
      Enabled: true
      Topic:
        Value: /landing_target_pose
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Shape: Axes
      Axes Length: 1.5
      Axes Radius: 0.15

    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic:
        Value: /odometry/filtered
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Keep: 200
      Position Tolerance: 0.5
      Shape:
        Value: Arrow
        Color: 255; 200; 40
        Alpha: 0.6
        Shaft Length: 0.6
        Shaft Radius: 0.08
        Head Length: 0.25
        Head Radius: 0.16
      Covariance:
        Value: false

  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Orbit
      Distance: 55
      Pitch: 0.55
      Yaw: 2.2
      Focal Point:
        X: 15
        Y: 0
        Z: 4
      Target Frame: map
Window Geometry:
  Height: 900
  Width: 1100
  Displays:
    collapsed: false
