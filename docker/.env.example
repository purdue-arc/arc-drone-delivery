USER_UID=1000
USER_GID=1000
# Must be 0 to match PX4's uxrce_dds_client (UXRCE_DDS_DOM_ID)
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
DISPLAY=:0

# --- perception --------------------------------------------------------------
# Edge length of the printed tag's BLACK QUAD, in metres — not the sheet.
TAG_SIZE_M=0.165
TARGET_TAG_ID=0

# ZED 2i intrinsics. REQUIRED on hardware: zed_apriltag_node now refuses to
# start without them rather than running in a mode where it can detect tags but
# can never publish /landing_target_pose.
#
# The variable is CALIB_FILE. It used to be spelled ZED_CALIB_FILE here, which
# no compose file read, so it resolved empty on every hardware run and the
# calibration was silently dropped.
#
# Path INSIDE the container (the repo is mounted at /home/arc/arc_ws). Generate
# it with landing/zed_apriltag_streaming/scripts/zed_calib_to_yaml.py.
CALIB_FILE=/home/arc/arc_ws/config/zed/zed2i_hd720.yaml

PUBLISH_DEBUG_IMAGE=false

# --- delivery ----------------------------------------------------------------
# Destination. Leave unset/nan for a search-and-land with no delivery leg.
DELIVERY_LAT=nan   # e.g. 40.4237
DELIVERY_LON=nan   # e.g. -86.9212
TRANSIT_HEIGHT_M=15.0
WINCH_HOVER_HEIGHT_M=12.0

# --- flight envelope ---------------------------------------------------------
# Companion-side fence, metres. Set to your test site and mirror it in the PX4
# GF_* parameters — see config/px4/README.md.
MAX_ALTITUDE_M=40.0
MAX_RANGE_M=500.0
# Refuse to fly a transit that has never received an obstacle plan.
REQUIRE_PLAN_TO_TRANSIT=true

# --- flight recorder ---------------------------------------------------------
RECORD=true
BAG_DIR=/home/arc/arc_ws/bags/flight

# --- PX4 topic names ---------------------------------------------------------
# Defaults match navigation-stack/PX4-Autopilot, which publishes UNVERSIONED
# names. Verify on the aircraft with: ros2 topic list | grep fmu/out
# If that release appends _v1/_v2, override ALL FOUR — a partial override is
# indistinguishable from a dead DDS link.
PX4_STATUS_TOPIC=/fmu/out/vehicle_status_v2
PX4_LOCAL_POSITION_TOPIC=/fmu/out/vehicle_local_position_v1
PX4_BATTERY_TOPIC=/fmu/out/battery_status_v1
PX4_LAND_DETECTED_TOPIC=/fmu/out/vehicle_land_detected
